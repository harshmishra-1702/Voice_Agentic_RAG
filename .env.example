# ==============================================================================
# VoiceOps — Environment Configuration Template
# ==============================================================================
# IMPORTANT: This is a placeholder template for configuration hygiene.
# DO NOT place real API keys or sensitive production secrets in this file.
#
# INSTRUCTIONS:
# 1. Copy this file to create your local environment file:
#      cp .env.example .env      (Linux / macOS)
#      copy .env.example .env    (Windows CMD)
# 2. Populate .env with your valid credentials.
# 3. Verify .env is listed in .gitignore (never commit live credentials).
# 4. Run preflight check: python -m agent.preflight
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LIVEKIT CLOUD / SELF-HOSTED SFU
# ------------------------------------------------------------------------------
# Required for WebRTC real-time bidirectional media transport and data channel.
# Create a free project at: https://cloud.livekit.io/
LIVEKIT_URL=wss://your-project-subdomain.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# ------------------------------------------------------------------------------
# 2. RIME TEXT-TO-SPEECH (TTS) — PRIMARY SPEECH SYNTHESIS
# ------------------------------------------------------------------------------
# Official Rime API Key for low-latency conversational speech synthesis.
# Get an API key at: https://rime.ai/
RIME_API_KEY=your_rime_api_key_here

# Rime Production Configuration (validated by agent/preflight.py)
# Model ID: coda (Rime conversational model)
# Speaker ID: astra (Clear technical/conversational English voice)
# Audio Transport: WebSocket (wss://users.rime.ai/v1/rime-tts) with word timestamps
TTS_PROVIDER=rime
RIME_MODEL=coda
RIME_SPEAKER=astra

# ------------------------------------------------------------------------------
# 3. DEEPGRAM SPEECH-TO-TEXT (STT) — PRIMARY TRANSCRIPTION
# ------------------------------------------------------------------------------
# Required for real-time streaming voice activity transcription.
# Get an API key at: https://deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here
STT_PROVIDER=deepgram

# ------------------------------------------------------------------------------
# 4. LARGE LANGUAGE MODEL (LLM) PROVIDERS
# ------------------------------------------------------------------------------
# Supported providers: 'openrouter', 'groq', 'ollama'
LLM_PROVIDER=openrouter

# OpenRouter Configuration (Recommended default for fast function calling)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Groq Configuration (Alternative ultra-low latency LLM provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b

# Ollama Local Configuration (Optional offline fallback)
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3

# ------------------------------------------------------------------------------
# 5. AGENTIC RETRIEVAL & SEARCH TOOLS
# ------------------------------------------------------------------------------
# Tavily API: Live real-world internet search for current incident data
# Get an API key at: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Jina AI Reader API: Full markdown webpage content extraction (Optional)
# Get an API key at: https://jina.ai/
JINA_API_KEY=your_jina_api_key_here

# ------------------------------------------------------------------------------
# 6. LOCAL VECTOR STORE (CHROMADB & EMBEDDINGS)
# ------------------------------------------------------------------------------
# ChromaDB and sentence-transformers run locally on-device.
# No API keys or remote vector database connections are required.
# Model: sentence-transformers/all-MiniLM-L6-v2 (offline inference)
