# VoiceOps — Environment Variables
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env itself — only this .env.example file.

# LiveKit (Cloud or self-hosted)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# Rime TTS
RIME_API_KEY=your_key_here

# Deepgram STT
DEEPGRAM_API_KEY=your_key_here

# LLM Provider override (openrouter, groq, ollama)
LLM_PROVIDER=openrouter

# OpenRouter LLM
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Tavily Web Search
TAVILY_API_KEY=your_tavily_api_key_here

# Jina AI Reader API (Optional)
JINA_API_KEY=your_api_key_here
